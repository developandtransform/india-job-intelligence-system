# =====================================================================
#  INDIA JOB INTELLIGENCE SYSTEM - the ONE configuration file
#  Copy this file to ".env" (same folder) and fill in your values.
#  Lines starting with # are comments. Do not put spaces around "=".
#  Every variable is explained in README.md -> "Configuration reference".
# =====================================================================

# ---------- GOOGLE SHEETS (required) ----------
GOOGLE_SHEET_ID=
# The whole service-account JSON key, converted to ONE line of Base64 (see README step "Google Sheets")
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# ---------- EMAIL DIGEST (required for emails) ----------
EMAIL_ENABLED=true
GMAIL_ADDRESS=
# A 16-character Gmail APP PASSWORD (not your normal Google password)
GMAIL_APP_PASSWORD=
EMAIL_RECIPIENT=
EMAIL_MAX_JOBS_PER_CATEGORY=15

# ---------- APIFY (optional, paid, everything OFF by default) ----------
APIFY_TOKEN=
# Master switch. Nothing from Apify runs unless this is true.
APIFY_ENABLED=false
APIFY_ENABLE_LINKEDIN=false
APIFY_ENABLE_NAUKRI=false
APIFY_ENABLE_IIMJOBS=false
APIFY_ENABLE_GLASSDOOR=false
APIFY_ENABLE_GOOGLE_JOBS=false
APIFY_ENABLE_WORKDAY=false
# Your explicit spending approval, in US dollars, for ONE daily run (all actors together). 0 = nothing approved.
APIFY_APPROVED_MAX_USD_PER_RUN=0
# Hard ceiling per single actor run, in US dollars (passed to Apify as maxTotalChargeUsd)
APIFY_MAX_USD_PER_ACTOR=0.50
# Maximum number of result rows per actor run
APIFY_MAX_RESULTS_LINKEDIN=50
APIFY_MAX_RESULTS_NAUKRI=100
APIFY_MAX_RESULTS_IIMJOBS=50
APIFY_MAX_RESULTS_GLASSDOOR=50
APIFY_MAX_RESULTS_GOOGLE_JOBS=50
APIFY_MAX_RESULTS_WORKDAY=200
APIFY_RUN_TIMEOUT_SECONDS=600
# How many of the daily search queries each enabled actor may run (each query is a separate paid run)
APIFY_MAX_QUERIES_PER_ACTOR=2
# Optional extra input for one actor as a single-line JSON object merged over the defaults, e.g.
# APIFY_INPUT_JSON_LINKEDIN={"datePosted":"anytime"}
APIFY_INPUT_JSON_LINKEDIN=
APIFY_INPUT_JSON_NAUKRI=
APIFY_INPUT_JSON_IIMJOBS=
APIFY_INPUT_JSON_GLASSDOOR=
APIFY_INPUT_JSON_GOOGLE_JOBS=
APIFY_INPUT_JSON_WORKDAY=

# ---------- OPTIONAL AI (free tier is enough; rules-based fallback always works) ----------
GEMINI_API_KEY=
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_CALLS_PER_RUN=20

# ---------- FREE SOURCES ----------
ENABLE_JOBSPY=true
# Comma list from: naukri,indeed,linkedin,glassdoor,google
JOBSPY_SITES=naukri,indeed,linkedin
JOBSPY_RESULTS_PER_QUERY=25
JOBSPY_HOURS_OLD=72
# How many of the search queries to run per day (queries rotate so all are covered over a few days)
JOBSPY_MAX_QUERIES_PER_RUN=12
JOBSPY_LINKEDIN_FETCH_DESCRIPTION=true
# Optional proxy list, comma separated, format user:pass@host:port (leave empty for none)
JOBSPY_PROXIES=
ENABLE_ATS=true
ENABLE_CAREER_PAGES=true
# Extra ATS boards, comma separated. Examples: greenhouse:stripe,lever:spotify,workday:https://nvidia.wd5.myworkdayjobs.com/NVIDIAExternalCareerSite
ATS_BOARDS_EXTRA=
# Extra career-page URLs to read (JSON-LD JobPosting), comma separated
CAREER_PAGE_URLS_EXTRA=

# ---------- JOB ELIGIBILITY (the rules) ----------
MINIMUM_CTC_LPA=8
MINIMUM_INTERNSHIP_STIPEND_INR_MONTHLY=10000
MAXIMUM_EXPERIENCE_YEARS=3
STARTUP_MIN_AGE_YEARS=5
STARTUP_MIN_EMPLOYEES=90
# How to treat the bundled, UNVERIFIED company seed (config/company_seed.yaml):
#   flag   = use it, but mark every affected job with a visible warning (default)
#   strict = ignore it for eligibility: such companies go to 'Company Verification Required'
COMPANY_SEED_MODE=flag
STRONG_MATCH_MIN_SCORE=70
POSSIBLE_MATCH_MIN_SCORE=45

# ---------- SYSTEM SETTINGS ----------
TIMEZONE=Asia/Kolkata
# Informational only (shown in the email footer). The real schedule is the cron line in .github/workflows/daily_jobs.yml
DAILY_RUN_TIME=09:00
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=25
HTTP_MAX_RETRIES=3
REQUEST_DELAY_SECONDS=1.0
# Maximum seconds one source (JobSpy / ATS / career pages / each Apify actor) may run
SOURCE_TIME_BUDGET_SECONDS=900
# Mark a job "Possibly Closed" when no source has shown it for this many days
STALE_AFTER_DAYS=30
# Mark an ATS job "Closed" after its whole board was fetched successfully this many times without it
CLOSE_AFTER_MISSED_RUNS=2
# true = do everything except writing to Google Sheets and sending email
DRY_RUN=false
# false = jobs outside India or in unrelated functions are only counted in Source Statistics, not stored row by row
STORE_OUT_OF_SCOPE_JOBS=false
